<?xml version="1.0" encoding="utf-8" ?>
<!--
Supply Point Views
==================

This file contains views for managing supply points in energy self-consumption
projects. Supply points represent electricity consumption locations that can
participate in self-consumption projects.

Main functionalities:
- Form view with complete supply point details
- Tree view for supply point listing
- Address management with Spanish country default
- Integration with self-consumption project assignations
- Partner and owner relationship management
- Power and tariff configuration
-->
<odoo>
    <data>

        <!-- Form View: Supply Point Details -->
        <record id="supply_point_form_view" model="ir.ui.view">
            <field name="name">energy_selfconsumption.supply_point.form</field>
            <field name="model">energy_selfconsumption.supply_point</field>
            <field name="arch" type="xml">
                <form string="Supply Points" create="false">
                    <header>
                        <button
                            name="action_open_modify_wizard"
                            type="object"
                            string="Modify Supply Point"
                            class="oe_highlight"
                            groups="energy_project.group_admin"
                        />
                    </header>
                    <sheet>
                        <!-- Supply point title -->
                        <div class="oe_title">
                            <label for="name" />
                            <h1>
                                <field name="name" placeholder="Title" readonly="1" />
                            </h1>
                        </div>
                        
                        <!-- Main supply point information -->
                        <group>
                            <!-- Left column: Technical and partner data -->
                            <group>
                                <!-- CUPS identification code -->
                                <field name="id" invisible="1" />
                                <field name="code" attrs="{'readonly': [('id', '!=', False)]}" />
                                
                                <!-- Partner relationships -->
                                <field name="partner_id"
                                       options="{'no_create': True}"
                                       attrs="{'readonly': [('id', '!=', False)]}" />
                                <field name="owner_id"
                                       domain="['|', ('member', '=' , False), ('id', '=', partner_id)]"
                                       attrs="{'readonly': [('id', '!=', False)]}" />
                                
                                <!-- Energy suppliers -->
                                <field name="reseller_id"
                                       options="{'no_create': True, 'no_edit':True, 'no_open': True}" />
                                <field name="supplier_id"
                                       options="{'no_create': True, 'no_edit':True, 'no_open': True}" />
                                
                                <!-- Location reference -->
                                <field name="cadastral_reference" />
                                
                                <!-- Power configuration -->
                                <field name="contracted_power" />
                                
                                <!-- High power warning -->
                                <p colspan="2"
                                   class="text-warning"
                                   attrs="{'invisible': [('contracted_power', '&lt;', 100)]}">
                                    <b>
                                        The indicated maximum contracted power is very high.
                                        Please check that this is correct.
                                    </b>
                                </p>
                                
                                <!-- Tariff configuration -->
                                <field name="tariff" />
                            </group>
                            
                            <!-- Right column: Address information -->
                            <group>
                                <span class="o_form_label o_td_label" name="address_name">
                                    <b>Address</b>
                                </span>
                                <div class="o_address_format">
                                    <field name="street"
                                           placeholder="Street..."
                                           class="o_address_street" />
                                    <field name="street2"
                                           placeholder="Street 2..."
                                           class="o_address_street" />
                                    <field name="city"
                                           placeholder="City"
                                           class="o_address_city" />
                                    <field name="state_id"
                                           class="o_address_state"
                                           placeholder="State"
                                           options="{'no_open': True, 'no_quick_create': True}"
                                           context="{'country_id': country_id, 'default_country_id': country_id, 'zip': zip}" />
                                    <field name="zip"
                                           placeholder="ZIP"
                                           class="o_address_zip" />
                                    <field name="country_id"
                                           placeholder="Country"
                                           class="o_address_country"
                                           options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}" />
                                </div>
                            </group>
                        </group>

                        <!-- Additional information tabs -->
                        <notebook>
                            <!-- Self-consumption projects tab -->
                            <page string="Self-consumption Projects"
                                  name="selfconsumption_project"
                                  autofocus="autofocus">
                                <field name="supply_point_assignation_ids">
                                    <tree default_order="distribution_table_create_date desc">
                                        <field name="selfconsumption_project_id"
                                               string="Name" />
                                        <field name="distribution_table_id" />
                                        <field name="distribution_table_state" />
                                        <field name="energy_shares" />
                                        <field name="coefficient" />
                                        <field name="distribution_table_create_date" />
                                    </tree>
                                </field>
                            </page>
                            <page string="Inscriptions" name="inscriptions">
                                <field name="inscription_ids">
                                    <tree
                                        create="false"
                                        delete="false"
                                        edit="false"
                                        default_order="create_date desc"
                                    >
                                        <field name="company_id" invisible="1" />
                                        <field name="state" readonly="1" />
                                        <field name="partner_id" string="Cooperator" readonly="1" />
                                        <field name="create_date" string="Reception date" readonly="1" />
                                        <field name="effective_date" readonly="1" />
                                        <field name="selfconsumption_project_id" string="Project" readonly="1" />
                                        <field name="participation_quantity" readonly="1" />
                                        <field name="participation_assigned_quantity" readonly="1" />
                                        <field name="participation_real_quantity" readonly="1" />
                                        <field name="acc_number" string="IBAN" readonly="1" />
                                    </tree>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    
                    <!-- Communication and activity tracking -->
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers" />
                        <field name="activity_ids" widget="mail_activity" />
                        <field name="message_ids" widget="mail_thread" />
                    </div>
                </form>
            </field>
        </record>

        <!-- Tree View: Supply Point List -->
        <record id="supply_point_tree_view" model="ir.ui.view">
            <field name="name">energy_selfconsumption.supply_point.tree</field>
            <field name="model">energy_selfconsumption.supply_point</field>
            <field name="arch" type="xml">
                <tree string="Supply Points" create="false">
                    <!-- Main identification fields -->
                    <field name="street" />
                    <field name="city" string="Population" />
                    <field name="code" />
                    <field name="partner_id" />
                    <field name="owner_id" />
                </tree>
            </field>
        </record>

        <!-- Search View: CUPS, cooperator, owner and predefined filters -->
        <record id="supply_point_search_view" model="ir.ui.view">
            <field name="name">energy_selfconsumption.supply_point.search</field>
            <field name="model">energy_selfconsumption.supply_point</field>
            <field name="arch" type="xml">
                <search string="Supply Points">
                    <field name="name" />
                    <field name="code" />
                    <field name="partner_id" />
                    <field name="owner_id" />
                    <separator />
                    <filter
                        name="linked_to_distribution_table"
                        string="Linked to a distribution table"
                        domain="[('supply_point_assignation_ids', '!=', False)]"
                    />
                    <filter
                        name="linked_to_active_distribution_table"
                        string="Linked to an active distribution table"
                        domain="[('supply_point_assignation_ids.distribution_table_state', '=', 'active')]"
                    />
                    <filter
                        name="partner_differs_from_owner"
                        string="Cooperator different from owner"
                        domain="[('partner_differs_from_owner', '=', True)]"
                    />
                </search>
            </field>
        </record>

        <!-- Action Window: Supply Points -->
        <record id="supply_point_form_act_window" model="ir.actions.act_window">
            <field name="name">Supply Points</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">energy_selfconsumption.supply_point</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No supply points yet.
                </p>
                <p>
                    Supply points are created from an inscription or from a CSV import.
                </p>
            </field>
            <!-- Default to Spanish country -->
            <field name="context" eval="{'default_country_id': ref('base.es')}" />
        </record>

        <!-- Menu Item: Supply Points -->
        <menuitem name="Supply Points"
                  id="supply_point_menu"
                  action="supply_point_form_act_window"
                  parent="management_category_menu" />
                  
    </data>
</odoo>
