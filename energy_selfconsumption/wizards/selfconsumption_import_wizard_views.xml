<?xml version="1.0" encoding="utf-8" ?>
<!--
Self-consumption Import Wizard Views
====================================

This file contains views for the self-consumption import wizard that allows
bulk import of inscriptions and supply points data from CSV files.

Main functionalities:
- CSV file upload with configurable format options
- Template download for proper file format
- Auto-generation of test data (admin only)
- Bank details import configuration awareness
- File format validation and processing
- Support for different delimiters, encodings, and date formats
-->
<odoo>
    <data>

        <!-- Form View: Self-consumption Import Wizard -->
        <record id="selfconsumption_import_wizard_form_view" model="ir.ui.view">
            <field name="name">energy_selfconsumption.selfconsumption_import.wizard.form</field>
            <field name="model">energy_selfconsumption.selfconsumption_import.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <!-- Instructions and Information -->
                        <p>You can download an example template for the importation of inscriptions and supply points.
                           The template must have the following format and be a CSV file.</p>

                        <div attrs="{'invisible': [('hidden_fields_alert', '=', False)]}"
                             style="color: red;">
                            <field name="hidden_fields_alert" nolabel="1" readonly="1"/>
                        </div>

                        <!-- Sample data. Hide this whole group later, not each control. -->
                        <group name="sample_inscriptions"
                               string="Sample inscriptions"
                               attrs="{'invisible': [('user_current_role', '!=', 'role_platform_admin')]}">
                            <label for="sample_count"/>
                            <div class="o_row">
                                <field name="sample_count" nolabel="1" class="oe_inline"/>
                                <button type="object"
                                        class="btn btn-secondary"
                                        string="Generate sample inscriptions"
                                        name="action_generate_sample_inscriptions"/>
                                <button type="object"
                                        class="btn btn-secondary"
                                        string="Delete sample inscriptions"
                                        name="action_delete_sample_inscriptions"/>
                            </div>
                        </group>

                        <button type="object"
                                class="btn btn-primary mr-1"
                                name="download_template_button">
                            Download Template
                        </button>
                        
                        <separator />
                        
                        <!-- File Upload Section -->
                        <group>
                            <!-- Hidden control fields -->
                            <field name="user_current_role" invisible="1" />
                            <field name="project_id" invisible="1" />
                            <field name="conf_bank_details" invisible="1" />
                            
                            <!-- File upload -->
                            <field name="import_file"
                                   filename="fname"
                                   widget="binary" />
                            <field name="fname" invisible="1" />
                        </group>
                        
                        <!-- CSV Format Configuration -->
                        <group>
                            <field name="date_format" />
                            <field name="delimiter" />
                            <field name="quotechar" />
                            <field name="encoding" />
                        </group>
                    </sheet>
                    
                    <!-- Footer with Import Action -->
                    <footer>
                        <button type="object" name="import_file_button">Import</button>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action Window: Self-consumption Import Wizard -->
        <record id="button_action_selfconsumption_import_wizard" model="ir.actions.act_window">
            <field name="name">Import Inscriptions and Supply Points</field>
            <field name="res_model">energy_selfconsumption.selfconsumption_import.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
    </data>
</odoo>
