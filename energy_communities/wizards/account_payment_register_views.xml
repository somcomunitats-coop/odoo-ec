<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_payment_register_form" model="ir.ui.view">
        <field name="name">account.payment.register.form.invoice.date</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form" />
        <field name="arch" type="xml">
            <field name="payment_date" position="before">
                <field name="payment_date_equals_invoice_date" />
            </field>
            <field name="payment_date" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': [('payment_date_equals_invoice_date', '=', True)]}</attribute>
            </field>
            <field name="group_payment" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': ['|', ('can_group_payments', '=', False), ('payment_date_equals_invoice_date', '=', True)]}</attribute>
            </field>
        </field>
    </record>
</odoo>
