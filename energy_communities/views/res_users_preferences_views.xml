<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_users_form_simple_modif_hide_preferences" model="ir.ui.view">
        <field name="name">res.users.preferences.form.hide.advanced</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="hide_advanced_user_preferences" invisible="1" />
            </field>
            <xpath
                expr="//group[@name='auth']/following-sibling::group[1]"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'invisible': [('hide_advanced_user_preferences', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_users_form_simple_modif_mail_hide_preferences" model="ir.ui.view">
        <field name="name">res.users.preferences.form.mail.hide.advanced</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="mail.view_users_form_simple_modif_mail" />
        <field name="arch" type="xml">
            <field name="notification_type" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': [('hide_advanced_user_preferences', '=', True)]}</attribute>
            </field>
        </field>
    </record>

    <record id="view_users_form_preferences_mail_bot_hide" model="ir.ui.view">
        <field name="name">res.users.preferences.form.mail.bot.hide.advanced</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="mail_bot.res_users_view_form_preferences" />
        <field name="arch" type="xml">
            <field name="odoobot_state" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': ['|', ('share', '=', True), ('hide_advanced_user_preferences', '=', True)]}</attribute>
            </field>
        </field>
    </record>

    <record
        id="view_users_form_simple_modif_technical_features_hide"
        model="ir.ui.view"
    >
        <field name="name">res.users.preferences.form.technical.features.hide</field>
        <field name="model">res.users</field>
        <field
            name="inherit_id"
            ref="base_technical_features.view_users_form_simple_modif"
        />
        <field name="arch" type="xml">
            <field name="technical_features" position="attributes">
                <attribute
                    name="attrs"
                >{'invisible': ['|', ('show_technical_features', '=', False), ('hide_advanced_user_preferences', '=', True)]}</attribute>
            </field>
        </field>
    </record>

    <record id="view_users_preferences_totp_hide" model="ir.ui.view">
        <field name="name">res.users.preferences.form.totp.hide</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="auth_totp.view_totp_field" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='totp_enabled']/following-sibling::div[1]"
                position="attributes"
            >
                <attribute
                    name="attrs"
                >{'invisible': [('hide_advanced_user_preferences', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
